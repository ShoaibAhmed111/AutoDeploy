{
  "name": "autodeploy-app",
  "version": "1.0.0",
  "description": "AutoDeploy - CI/CD Pipeline Demo Application",
  "main": "app/src/server.js",
  "scripts": {
    "start": "node app/src/server.js",
    "dev": "nodemon app/src/server.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:ci": "jest --forceExit --detectOpenHandles --ci --reporters=default"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "verbose": true,
    "testTimeout": 10000
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "AutoDeploy CI/CD",
  "license": "MIT"
}
